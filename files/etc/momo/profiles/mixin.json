{
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local"
      },
      {
        "tag": "doh-ali",
        "type": "https",
        "server": "223.5.5.5",
        "domain_resolver": "local"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "domain": [
          "cloudflare-ech.com"
        ],
        "server": "doh-ali"
      },
      {
        "rule_set": "geosite-cn",
        "server": "local"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      }
    ],
    "final": "local",
    "strategy": "prefer_ipv4",
    "optimistic": true,
    "reverse_mapping": true
  },
  "outbounds": [
    {
      "tag": "节点选择",
      "type": "selector",
      "outbounds": [
        "自动选择",
        "Google自动",
        "手动选择",
        "美国节点",
        "日本节点",
        "香港节点",
        "DIRECT"
      ]
    },
    {
      "tag": "Google",
      "type": "selector",
      "outbounds": [
        "Google自动",
        "手动选择",
        "节点选择",
        "DIRECT"
      ]
    },
    {
      "tag": "手动选择",
      "type": "selector",
      "exclude": "流量|到期|剩余|官网|通知|网站|重置|套餐"
    },
    {
      "tag": "自动选择",
      "type": "urltest",
      "exclude": "流量|到期|剩余|官网|通知|网站|重置|套餐",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "tag": "Google自动",
      "type": "urltest",
      "include": "美|US|United States|USA",
      "exclude": "流量|到期|剩余|官网|通知|网站|重置|套餐|0.01倍",
      "url": "https://alkalimakersuite-pa.clients6.google.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "tag": "美国节点",
      "type": "urltest",
      "include": "美|US|United States",
      "exclude": "流量|到期|剩余|官网|通知|网站|重置|套餐",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "tag": "日本节点",
      "type": "urltest",
      "include": "日|JP|Japan",
      "exclude": "流量|到期|剩余|官网|通知|网站|重置|套餐",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "tag": "香港节点",
      "type": "urltest",
      "include": "港|HK|Hong Kong",
      "exclude": "流量|到期|剩余|官网|通知|网站|重置|套餐",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    }
  ],
  "route": {
    "rule_set": [
      {
        "tag": "geosite-ads",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs",
        "download_detour": "DIRECT",
        "update_interval": "24h"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "download_detour": "DIRECT",
        "update_interval": "24h"
      },
      {
        "tag": "geosite-gemini",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google-gemini.srs",
        "download_detour": "DIRECT",
        "update_interval": "24h"
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "download_detour": "DIRECT",
        "update_interval": "24h"
      }
    ],
    "rules": [
      {
        "port": [53317],
        "outbound": "DIRECT"
      },
      {
        "protocol": "quic",
        "port": [443],
        "action": "reject"
      },
      {
        "rule_set": "geosite-ads",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-gemini",
          "geosite-google"
        ],
        "outbound": "Google"
      },
      {
        "rule_set": "geosite-cn",
        "outbound": "DIRECT"
      }
    ],
    "final": "节点选择",
    "default_domain_resolver": "local"
  }
}
