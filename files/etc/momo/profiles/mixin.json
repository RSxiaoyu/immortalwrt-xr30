{
  "prepend_rules": [
    { "ip_is_private": true, "outbound": "DIRECT" },
    { "protocol": ["bittorrent"], "outbound": "DIRECT" },
    { "rule_set": "geosite-ads", "action": "reject" },
    { "domain_suffix": ["accounts.google.com", "myaccount.google.com"], "outbound": "Gemini-Auto" },
    { "rule_set": "geosite-gemini", "outbound": "Gemini-Auto" },
    { "rule_set": "geosite-ai", "outbound": "AI网站" },
    { "rule_set": "geosite-cn", "outbound": "DIRECT" }
  ],
  "rule_set": [
    {
      "tag": "geosite-ads",
