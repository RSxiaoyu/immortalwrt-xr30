#!/bin/sh

# 1. 开启防火墙硬件流量分载 (MTK PPE / HNAT) 与软件分载
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'
uci commit firewall

# 2. 开启多核网络中断均衡 (Packet Steering)
uci set network.globals.packet_steering='1'
uci commit network

# 3. 优化 Wi-Fi 默认参数 (国家码 CN, 5G 启用 160MHz 频宽)
uci set wireless.radio0.country='CN'
uci set wireless.radio1.country='CN'
uci set wireless.radio1.band='5g'
uci set wireless.radio1.htmode='HE160'
uci commit wireless

# 4. 预置 Momo 官方软件源与公钥 (开箱即用，支持一键安装与在线更新)
mkdir -p /etc/opkg/keys
cat << 'EOF' > /etc/opkg/keys/momo.pub
untrusted comment: Nikki
RWSrAXyIqregizvXvG9kJI/JoTkaCCPDy6CQrrVQ4IZ8Qgu+iWMql0UW
EOF

if ! grep -q "momomomo.pages.dev" /etc/opkg/customfeeds.conf 2>/dev/null; then
    echo "src/gz momo https://momomomo.pages.dev/SNAPSHOT/aarch64_cortex-a53/momo" >> /etc/opkg/customfeeds.conf
fi

exit 0
