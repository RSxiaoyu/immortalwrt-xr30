#!/bin/sh

# 1. 开启防火墙硬件流量分载 (MTK PPE / HNAT) 与软件分载
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='1'
uci -q commit firewall || true

# 2. 开启多核网络中断均衡 (Packet Steering)
uci -q set network.globals.packet_steering='1'
uci -q commit network || true

# 3. 优化 TCP BBR 拥塞控制与 FQ 队列
mkdir -p /etc/sysctl.d
cat << 'EOF' > /etc/sysctl.d/99-bbr.conf
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
sysctl -p /etc/sysctl.d/99-bbr.conf 2>/dev/null || true

# 4. Wi-Fi 物理参数 (国家码合规 CN，5G 开启 160MHz 物理频宽)
uci -q set wireless.radio0.country='CN'
uci -q set wireless.radio1.country='CN'
uci -q set wireless.radio1.band='5g'
uci -q set wireless.radio1.htmode='HE160'
uci -q commit wireless || true

# 5. 预设 Momo 极简优雅默认值 (用户可在 WebUI 界面完全自由覆盖)
uci -q set momo.proxy.lan_inbound_interface='lan'
uci -q set momo.proxy.tcp_mode='tproxy'
uci -q set momo.proxy.udp_mode='tproxy'
uci -q set momo.proxy.ipv4_proxy='1'
uci -q set momo.proxy.ipv6_proxy='0'
uci -q set momo.proxy.ipv4_dns_hijack='1'
uci -q set momo.proxy.ipv6_dns_hijack='0'
uci -q set momo.proxy.fake_ip_ping_hijack='1'
uci -q set momo.mixin.external_control_api_listen='0.0.0.0:9090'
uci -q set momo.mixin.dns_strategy='prefer_ipv4'
uci -q commit momo || true

# 6. 放行 Sunshine 游戏串流入站 (IPv6 专属直连端口)
uci -q delete firewall.sunshine_ipv6
uci set firewall.sunshine_ipv6=rule
uci set firewall.sunshine_ipv6.name='Allow-Sunshine-IPv6'
uci set firewall.sunshine_ipv6.src='wan'
uci set firewall.sunshine_ipv6.dest='lan'
uci set firewall.sunshine_ipv6.proto='tcp udp'
uci set firewall.sunshine_ipv6.dest_port='47984 47989 47990 47998-48000 48002 48010'
uci set firewall.sunshine_ipv6.family='ipv6'
uci set firewall.sunshine_ipv6.target='ACCEPT'
uci -q commit firewall || true

ln -sf /etc/momo/profiles/mixin.json /etc/momo/mixin.json 2>/dev/null || true
/etc/init.d/sing-box disable 2>/dev/null || true

exit 0